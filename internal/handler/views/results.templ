package views

import (
	"fmt"
	"strconv"

	"github.com/pavelanni/examiner/internal/model"
)

templ ResultsPage(view model.SessionView, policy model.ResultsPolicy) {
	@Layout(td(ctx, "ResultsTitle", map[string]any{"ID": fmt.Sprint(view.Session.ID)})) {
		@Nav([]NavItem{
			{Label: t(ctx, "Home"), URL: p(ctx, "/")},
			{Label: td(ctx, "SessionN", map[string]any{"ID": fmt.Sprint(view.Session.ID)})},
		})
		<h1>{ td(ctx, "ResultsSessionN", map[string]any{"ID": fmt.Sprint(view.Session.ID)}) }</h1>
		if view.Session.Status.GradingPending() {
			<p role="status" hx-get={ p(ctx, fmt.Sprintf("/results/%d", view.Session.ID)) } hx-trigger="every 2s" hx-select="main" hx-target="main" hx-swap="outerHTML">
				{ t(ctx, "FinalGradePending") }
			</p>
		} else if view.Session.Status == model.StatusGradingFailed {
			<p role="status" hx-get={ p(ctx, fmt.Sprintf("/results/%d?status=grading_failed", view.Session.ID)) } hx-trigger="every 10s" hx-select="main" hx-target="main" hx-swap="outerHTML">
				{ t(ctx, "FinalGradeFailed") }
			</p>
		} else if view.Session.Status == model.StatusInProgress && view.Session.SubmittedAt != nil {
			<p role="status">{ t(ctx, "FinalGradeRetry") }
				<a href={ templ.SafeURL(p(ctx, fmt.Sprintf("/exam/%d", view.Session.ID))) }>{ t(ctx, "Continue") }</a>
			</p>
		} else if policy.Preliminary {
			@resultsNotice(t(ctx, "ResultsDisclaimer"))
		}
		if policy.Hidden && view.Session.Status != model.StatusAnnulled && view.Session.Status != model.StatusGradingFailed {
			@resultsNotice(t(ctx, "ResultsAwaitingReview"))
		}
		@attemptResetNotice(view)
		<p>{ t(ctx, "StatusLabel") } <strong>{ sessionStatusLabel(ctx, view.Session.Status) }</strong></p>
		{{ showGrades := !policy.Hidden && !view.Session.Status.GradingIncomplete() }}
		if view.Grade != nil && showGrades {
			<div class="score-box">
				if policy.LLMResults {
					<p>
						{ td(ctx, "LLMSuggestedGrade", map[string]any{"Grade": fmt.Sprintf("%.1f", view.Grade.LLMGrade)}) }
						if policy.Preliminary {
							<em>({ t(ctx, "Preliminary") })</em>
						}
					</p>
				}
				if view.Grade.FinalGrade != nil {
					<p>{ td(ctx, "FinalGrade", map[string]any{"Grade": fmt.Sprintf("%.1f", *view.Grade.FinalGrade)}) }</p>
				}
			</div>
		}
		for i, tv := range view.Threads {
			<div class="thread">
				<h3>{ td(ctx, "QuestionN", map[string]any{"N": strconv.Itoa(i + 1)}) }</h3>
				<p>
					<strong>{ tv.Question.Topic }</strong>
					({ DifficultyLabel(ctx, tv.Question.Difficulty) }, { td(ctx, "Points", map[string]any{"Points": strconv.Itoa(tv.Question.MaxPoints)}) })
				</p>
				<p class="question-text">{ tv.Question.Text }</p>
				if len(tv.Messages) > 0 {
					<div class="messages">
						for _, m := range tv.Messages {
							<div class={ "message", messageClass(m.Role) }>
								<div class="message-role">
									if m.Role == model.RoleStudent {
										{ t(ctx, "Student") }
									} else {
										{ t(ctx, "Evaluator") }
									}
								</div>
								if m.Role == model.RoleStudent {
									<div>{ m.Text() }</div>
								} else {
									<div class="markdown">@evaluatorMessage(m)
</div>
								}
							</div>
						}
					</div>
				}
				if tv.Score != nil && showGrades {
					<div class="score-box">
						if policy.LLMResults {
							<p>
								<strong>{ t(ctx, "LLMScore") }</strong> { fmt.Sprintf("%.1f", tv.Score.LLMScore) } / { strconv.Itoa(tv.Question.MaxPoints) }
								if policy.Preliminary {
									<em>({ t(ctx, "Preliminary") })</em>
								}
							</p>
							<div><strong>{ t(ctx, "LLMFeedback") }</strong> <div class="markdown">@markdown(tv.Score.LLMFeedback)
</div></div>
						}
						if tv.Score.TeacherScore != nil {
							<p><strong>{ t(ctx, "TeacherScore") }</strong> { fmt.Sprintf("%.1f", *tv.Score.TeacherScore) } / { strconv.Itoa(tv.Question.MaxPoints) }</p>
							if tv.Score.TeacherComment != "" {
								<p><strong>{ t(ctx, "TeacherComment") }</strong> { tv.Score.TeacherComment }</p>
							}
						}
					</div>
				}
			</div>
		}
	}
}

templ resultsNotice(msg string) {
	<div role="alert" style="background: var(--pico-primary-background); padding: 1rem; border-radius: 6px; margin-bottom: 1.5rem;">
		{ msg }
	</div>
}
