package views

// CSRFErrorPage is shown when a form POST fails CSRF validation, so the
// student knows to reload and retry instead of seeing a bare 403.
templ CSRFErrorPage() {
	@Layout(t(ctx, "AppTitle")) {
		<article>
			<header>{ t(ctx, "CSRFErrorTitle") }</header>
			<p>{ t(ctx, "CSRFError") }</p>
			<a href={ templ.SafeURL(p(ctx, "/")) } role="button">{ t(ctx, "Home") }</a>
		</article>
	}
}
