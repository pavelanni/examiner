package views

import (
    "fmt"
    "github.com/pavelanni/examiner/internal/model"
)

// BuilderQuestion is one question block of the constructor: the question
// and the stored question it edits (ID 0 for a new one).
type BuilderQuestion struct {
    ID int64 `json:"id,omitempty"`
    model.QuestionImport
}

// DupChoice asks what to do with a question that duplicates another one.
type DupChoice struct {
    N         int    // question number
    Msg       string // what it duplicates
    CanUpdate bool   // updating the matching question is allowed
    UpdateID  int64  // the question an update overwrites
}

// KeptDecision is a duplicate decision that was valid on the last save. The
// duplicate form sends it again, so answering the remaining questions does
// not drop it.
type KeptDecision struct {
    N     int    // question number
    Value string // "skip" or "update:<ID>", as the form posted it
}

// TeacherBuilder is the state of the constructor page.
type TeacherBuilder struct {
    Questions    []BuilderQuestion
    Filename     string // file being edited, "" for a new set
    CustomName   string // name as posted, kept after an error
    SetName      string // name shown in the name field and the title
    DefaultTopic string // filled into new question blocks
    Example      string // example file shown in the format help
    Published    bool
    Errs         []string
    Dups         []DupChoice
    DupToken     string // identifies the questions the choices were made for
    Kept         []KeptDecision
}

// safeJSONString encodes the questions for the page script; "[]" if that fails.
func safeJSONString(questions []BuilderQuestion) string {
    str, err := templ.JSONString(questions)
    if err != nil {
        return "[]"
    }
    return str
}

templ TeacherCreateTestPage(displayName string, csrf string, b TeacherBuilder) {
    @Layout(builderTitle(ctx, b)) {
        <style>
            #questions-list { counter-reset: question-counter; }
            .question-block { counter-increment: question-counter; margin: 1rem 0; }
            .question-title::after { content: " " counter(question-counter); }
            .question-head { display: flex; justify-content: space-between; align-items: center; }
            .question-head button { width: auto; margin: 0; }
            .mode-tabs { display: flex; gap: 0.5rem; margin: 1rem 0; }
            .mode-tabs button { width: auto; margin: 0; }
            .field-hint { display: block; margin: -0.5rem 0 1rem; }
        </style>
        <div style="display: flex; justify-content: space-between; align-items: center;">
            <h1>{ builderTitle(ctx, b) }</h1>
            <a href={ templ.SafeURL(p(ctx, "/teacher/profile")) }>{ t(ctx, "QSetBackToList") }</a>
        </div>
        @importMessages(b.Errs, nil)

        <form id="test-builder-form" method="POST" action={ templ.SafeURL(p(ctx, "/teacher/tests")) } enctype="multipart/form-data" onsubmit="return assembleAndSubmit()" data-mode="manual" data-msg-incomplete={ t(ctx, "QBuilderIncomplete") } data-msg-empty={ t(ctx, "QBuilderEmpty") }>
            <input type="hidden" name="csrf_token" value={ csrf }/>
            <input type="hidden" name="editing_file" value={ b.Filename }/>
            if len(b.Dups) > 0 {
                @duplicateChoices(b.Dups, b.DupToken, b.Kept)
            }

            <label for="custom_filename">{ t(ctx, "QSetName") }</label>
            <input type="text" id="custom_filename" name="custom_filename" value={ b.SetName } maxlength="100" placeholder={ t(ctx, "QSetNamePlaceholder") } aria-describedby="custom_filename_hint" required/>
            <small id="custom_filename_hint" class="field-hint">{ t(ctx, "QSetNameHint") }</small>

            <label for="default_topic">{ t(ctx, "QSetDefaultTopic") }</label>
            <input type="text" id="default_topic" name="default_topic" value={ b.DefaultTopic } placeholder={ t(ctx, "QSetDefaultTopicPlaceholder") } aria-describedby="default_topic_hint"/>
            <small id="default_topic_hint" class="field-hint">{ t(ctx, "QSetDefaultTopicHint") }</small>

            if b.Filename == "" {
                <div class="mode-tabs" role="tablist">
                    <button type="button" role="tab" id="tab-manual" data-mode="manual" aria-selected="true" aria-controls="manual-section">{ t(ctx, "QModeManual") }</button>
                    <button type="button" role="tab" id="tab-file" data-mode="file" aria-selected="false" aria-controls="file-section" class="outline">{ t(ctx, "QModeFile") }</button>
                </div>
            }

            <section id="manual-section">
                <div id="questions-list"></div>
                <button type="button" id="add-question" class="secondary">{ t(ctx, "QBlockAdd") }</button>
            </section>

            if b.Filename == "" {
                <section id="file-section" hidden>
                    <label for="questions-file">{ t(ctx, "QFileLabel") }</label>
                    <input type="file" id="questions-file" name="questions_file" accept="application/json,.json" aria-describedby="questions_file_hint" disabled/>
                    <small id="questions_file_hint" class="field-hint">{ t(ctx, "QFileHint") }</small>
                    @questionFormatHelp(b.Example)
                </section>
            }

            <label>
                <input type="checkbox" name="publish" value="1" checked?={ b.Published }/>
                { t(ctx, "QPublishLabel") }
            </label>

            <div id="builder-alert" role="alert" hidden style="color: var(--pico-del-color);"></div>
            <textarea id="assembled-json" name="questions_json" hidden></textarea>
            <input type="hidden" id="assembled-ids" name="question_ids"/>
            <input type="hidden" id="preloaded-data" value={ safeJSONString(b.Questions) }/>

            <button type="submit">{ t(ctx, "QSetSave") }</button>
        </form>

        <template id="question-template">
            @questionBlock()
        </template>

        <script>
        const builderForm = document.getElementById('test-builder-form');
        const questionTemplate = document.getElementById('question-template');
        const defaultTopicInput = document.getElementById('default_topic');
        let qCounter = 0;

        // addQuestion clones the question template; data prefills a stored
        // question (data.id is its ID, 0 or absent for a new one).
        function addQuestion(data = {}) {
            const container = document.getElementById('questions-list');
            const idx = qCounter++;
            const wrapper = document.createElement('div');
            wrapper.innerHTML = questionTemplate.innerHTML.replaceAll('__IDX__', String(idx));
            const block = wrapper.querySelector('.question-block');
            block.dataset.qid = String(Number(data.id) || 0);
            const set = (field, value) => {
                const el = block.querySelector('[name="' + field + idx + '"]');
                if (el && value !== undefined && value !== null && value !== '') el.value = value;
            };
            set('q_text_', data.text);
            set('q_topic_', data.topic !== undefined ? data.topic : defaultTopicInput.value.trim());
            set('q_diff_', data.difficulty);
            set('q_points_', data.max_points);
            set('q_rubric_', data.rubric);
            set('q_answer_', data.model_answer);
            block.querySelector('.remove-question').addEventListener('click', () => removeQuestion(idx));
            block.querySelectorAll('input, textarea, select').forEach(el => el.addEventListener('input', () => el.removeAttribute('aria-invalid')));
            container.appendChild(block);
            return idx;
        }

        // removeQuestion removes a block; the list never stays empty.
        function removeQuestion(idx) {
            const el = document.querySelector('.question-block[data-idx="' + idx + '"]');
            if (el) el.remove();
            if (!document.querySelector('.question-block')) addQuestion();
        }

        // The default topic goes into every block whose topic is still empty.
        function applyDefaultTopic() {
            const topic = defaultTopicInput.value.trim();
            if (!topic) return;
            document.querySelectorAll('.question-block [name^="q_topic_"]').forEach(el => {
                if (!el.value.trim()) el.value = topic;
            });
        }

        // setMode switches between typing questions and uploading a file. In
        // manual mode the file input is disabled, so a file chosen earlier is
        // never posted.
        function setMode(mode) {
            const fileSection = document.getElementById('file-section');
            if (!fileSection) return;
            builderForm.dataset.mode = mode;
            document.querySelectorAll('.mode-tabs button').forEach(tab => {
                const active = tab.dataset.mode === mode;
                tab.setAttribute('aria-selected', String(active));
                tab.classList.toggle('outline', !active);
            });
            const manualSection = document.getElementById('manual-section');
            manualSection.hidden = mode !== 'manual';
            // Hidden fields still take part in the browser's form checks:
            // disable them (values stay) so they cannot block a file upload.
            manualSection.querySelectorAll('input, textarea, select, button').forEach(el => { el.disabled = mode !== 'manual'; });
            fileSection.hidden = mode !== 'file';
            const fileInput = document.getElementById('questions-file');
            fileInput.disabled = mode !== 'file';
            fileInput.required = mode === 'file';
            showAlert('');
        }

        function showAlert(text) {
            const box = document.getElementById('builder-alert');
            box.textContent = text;
            box.hidden = !text;
        }

        function initQuestionBuilder() {
            const addButton = document.getElementById('add-question');
            if (addButton) {
                addButton.addEventListener('click', () => addQuestion());
            }
            defaultTopicInput.addEventListener('change', applyDefaultTopic);
            document.querySelectorAll('.mode-tabs button').forEach(tab => tab.addEventListener('click', () => setMode(tab.dataset.mode)));

            let questionsObj = [];
            const preloadedEl = document.getElementById('preloaded-data');
            if (preloadedEl && preloadedEl.value) {
                try {
                    questionsObj = JSON.parse(preloadedEl.value);
                } catch (e) {
                    console.error("Failed to parse preloaded questions:", e);
                }
            }
            if (Array.isArray(questionsObj) && questionsObj.length > 0) {
                questionsObj.forEach(q => addQuestion(q));
            } else {
                addQuestion();
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initQuestionBuilder);
        } else {
            initQuestionBuilder();
        }

        // assembleAndSubmit posts the typed questions as questions_json and
        // their stored IDs as question_ids. A block counts as started once its
        // text, criteria or model answer is filled (topic and points have
        // defaults); untouched blocks are ignored. The server validates again.
        function assembleAndSubmit() {
            showAlert('');
            if (builderForm.dataset.mode === 'file') {
                document.getElementById('assembled-json').value = '';
                return true;
            }
            const questions = [];
            const ids = [];
            let firstInvalid = null;
            for (const b of document.querySelectorAll('.question-block')) {
                const idx = b.getAttribute('data-idx');
                const field = name => b.querySelector('[name="' + name + idx + '"]');
                const value = name => (field(name).value || '').trim();
                const text = value('q_text_'), topic = value('q_topic_'), rubric = value('q_rubric_'), answer = value('q_answer_');
                const pointsRaw = value('q_points_');
                const points = Number(pointsRaw);
                if (!text && !rubric && !answer) continue;
                const missing = [];
                if (!text) missing.push('q_text_');
                if (!topic) missing.push('q_topic_');
                if (!rubric) missing.push('q_rubric_');
                if (!answer) missing.push('q_answer_');
                if (pointsRaw === '' || !Number.isInteger(points) || points < 1) missing.push('q_points_');
                for (const name of missing) {
                    field(name).setAttribute('aria-invalid', 'true');
                    if (!firstInvalid) firstInvalid = field(name);
                }
                if (missing.length === 0) {
                    questions.push({ text, topic, difficulty: value('q_diff_') || 'easy', max_points: points, rubric, model_answer: answer });
                    ids.push(Number(b.dataset.qid) || 0);
                }
            }
            if (firstInvalid) {
                showAlert(builderForm.dataset.msgIncomplete);
                firstInvalid.focus();
                return false;
            }
            if (questions.length === 0) {
                showAlert(builderForm.dataset.msgEmpty);
                return false;
            }
            document.getElementById('assembled-json').value = JSON.stringify(questions);
            document.getElementById('assembled-ids').value = JSON.stringify(ids);
            return true;
        }
        </script>
    }
}

// questionBlock is one question of the constructor, cloned by the page
// script: __IDX__ becomes the block number in every name and id.
templ questionBlock() {
    <article class="question-block" data-idx="__IDX__" data-qid="0">
        <header class="question-head">
            <strong class="question-title">{ t(ctx, "QBlockTitle") }</strong>
            <button type="button" class="secondary outline remove-question">{ t(ctx, "QBlockRemove") }</button>
        </header>
        <label for="q_text___IDX__">{ t(ctx, "QBlockText") }</label>
        <textarea id="q_text___IDX__" name="q_text___IDX__" rows="3" aria-describedby="q_text_hint___IDX__"></textarea>
        <small id="q_text_hint___IDX__" class="field-hint">{ t(ctx, "QBlockTextHint") }</small>
        <div class="grid">
            <div>
                <label for="q_topic___IDX__">{ t(ctx, "QBlockTopic") }</label>
                <input type="text" id="q_topic___IDX__" name="q_topic___IDX__"/>
            </div>
            <div>
                <label for="q_diff___IDX__">{ t(ctx, "QBlockDifficulty") }</label>
                <select id="q_diff___IDX__" name="q_diff___IDX__">
                    for _, d := range model.Difficulties {
                        <option value={ string(d) }>{ DifficultyLabel(ctx, d) }</option>
                    }
                </select>
            </div>
            <div>
                <label for="q_points___IDX__">{ t(ctx, "QBlockPoints") }</label>
                <input type="number" id="q_points___IDX__" name="q_points___IDX__" min="1" step="1" value="5"/>
            </div>
        </div>
        <label for="q_rubric___IDX__">{ t(ctx, "QBlockRubric") }</label>
        <textarea id="q_rubric___IDX__" name="q_rubric___IDX__" rows="3" placeholder={ t(ctx, "QBlockRubricPlaceholder") } aria-describedby="q_rubric_hint___IDX__"></textarea>
        <small id="q_rubric_hint___IDX__" class="field-hint">{ t(ctx, "QBlockRubricHint") }</small>
        <label for="q_answer___IDX__">{ t(ctx, "QBlockAnswer") }</label>
        <textarea id="q_answer___IDX__" name="q_answer___IDX__" rows="3" aria-describedby="q_answer_hint___IDX__"></textarea>
        <small id="q_answer_hint___IDX__" class="field-hint">{ t(ctx, "QBlockAnswerHint") }</small>
    </article>
}

// duplicateChoices asks what to do with each duplicate question. The
// choices apply only to the questions identified by token; kept decisions
// are sent again as they are.
templ duplicateChoices(dups []DupChoice, token string, kept []KeptDecision) {
    <article role="alert" style="border-left: 4px solid var(--pico-primary);">
        <p><strong>{ t(ctx, "QDupTitle") }</strong></p>
        <input type="hidden" name="dup_token" value={ token }/>
        for _, k := range kept {
            <input type="hidden" name={ fmt.Sprintf("dup_%d", k.N) } value={ k.Value }/>
        }
        for _, d := range dups {
            <fieldset>
                <legend>{ d.Msg }</legend>
                <label><input type="radio" name={ fmt.Sprintf("dup_%d", d.N) } value="skip" checked?={ !d.CanUpdate } required/> { t(ctx, "QDupSkip") }</label>
                if d.CanUpdate {
                    <label><input type="radio" name={ fmt.Sprintf("dup_%d", d.N) } value={ fmt.Sprintf("update:%d", d.UpdateID) } required/> { td(ctx, "QDupUpdate", map[string]any{"ID": d.UpdateID}) }</label>
                }
            </fieldset>
        }
    </article>
}
