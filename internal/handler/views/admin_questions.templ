package views

import (
	"fmt"
	"strings"

	"github.com/pavelanni/examiner/internal/model"
)

templ AdminQuestionsPage(flashMsg string, flashErr bool, errs []string, warnings []string, dupGroups []model.DuplicateGroup) {
	@Layout(t(ctx, "AdminQuestions")) {
		@Nav([]NavItem{
			{Label: t(ctx, "Home"), URL: p(ctx, "/")},
			{Label: t(ctx, "Admin")},
			{Label: t(ctx, "AdminQuestions")},
		})
		<h1>{ t(ctx, "AdminQuestions") }</h1>
		if flashMsg != "" {
			if flashErr {
				<p style="color: var(--pico-del-color);">{ flashMsg }</p>
			} else {
				<p style="color: var(--pico-ins-color);">{ flashMsg }</p>
			}
		}
		@importMessages(errs, warnings)
		<form method="POST" action={ templ.SafeURL(p(ctx, "/admin/questions")) } enctype="multipart/form-data">
			<input type="hidden" name="csrf_token" value={ csrf(ctx) }/>
			<label for="questions_file">{ t(ctx, "QuestionsFile") }</label>
			<input type="file" id="questions_file" name="questions_file" accept=".json" required/>
			<label for="on_duplicate">{ t(ctx, "QImportOnDuplicate") }</label>
			<select id="on_duplicate" name="on_duplicate">
				<option value="skip" selected>{ t(ctx, "QImportOnDupSkip") }</option>
				<option value="update">{ t(ctx, "QImportOnDupUpdate") }</option>
			</select>
			<button type="submit">{ t(ctx, "UploadBtn") }</button>
		</form>
		@duplicateReport(dupGroups)
	}
}

// duplicateReport lists stored questions that duplicate each other.
templ duplicateReport(groups []model.DuplicateGroup) {
	if len(groups) > 0 {
		<section>
			<h2>{ t(ctx, "QDupReportTitle") }</h2>
			<p>{ t(ctx, "QDupReportHint") }</p>
			<ul>
				for _, g := range groups {
					<li>{ td(ctx, "QDupReportGroup", map[string]any{"Topic": g.Topic, "IDs": duplicateIDs(g), "Text": g.Questions[0].Text}) }</li>
				}
			</ul>
		</section>
	}
}

// duplicateIDs lists the question IDs of a duplicate group as "#3, #17".
func duplicateIDs(g model.DuplicateGroup) string {
	ids := make([]string, 0, len(g.Questions))
	for _, q := range g.Questions {
		ids = append(ids, fmt.Sprintf("#%d", q.ID))
	}
	return strings.Join(ids, ", ")
}

// importMessages lists question import errors and warnings. It is shared
// by the admin import page and the teacher constructor.
templ importMessages(errs []string, warnings []string) {
	if len(errs) > 0 {
		<article role="alert" style="border-left: 4px solid var(--pico-del-color);">
			<p><strong>{ t(ctx, "QImportErrorsTitle") }</strong></p>
			<ul>
				for _, e := range errs {
					<li>{ e }</li>
				}
			</ul>
		</article>
	}
	if len(warnings) > 0 {
		<ul>
			for _, w := range warnings {
				<li>{ w }</li>
			}
		</ul>
	}
}
