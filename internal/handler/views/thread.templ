package views

import (
	"context"
	"fmt"
	"strconv"

	"github.com/pavelanni/examiner/internal/model"
)

templ ThreadContent(thread model.QuestionThread, question model.Question, messages []model.Message, index int, session model.ExamSession, timeExceeded bool, liveScore model.LiveScorePolicy) {
	<h3>
		{ td(ctx, "QuestionN", map[string]any{"N": strconv.Itoa(index + 1)}) }
	</h3>
	<p class="question-meta">
		<strong>{ question.Topic }</strong>
		({ DifficultyLabel(ctx, question.Difficulty) }, { td(ctx, "Points", map[string]any{"Points": strconv.Itoa(question.MaxPoints)}) })
	</p>
	<p class="question-text">{ question.Text }</p>
	<div class="thread-feedback">
		@ThreadFeedback(thread, question, messages, session, timeExceeded, liveScore)
	</div>
}

templ ThreadFeedback(thread model.QuestionThread, question model.Question, messages []model.Message, session model.ExamSession, timeExceeded bool, liveScore model.LiveScorePolicy) {
	<span class={ "status-badge", "status-" + string(thread.Status) }>{ threadStatusLabel(ctx, thread.Status) }</span>
	if len(messages) > 0 {
		<div class="messages">
			for _, m := range messages {
				<div class={ "message", messageClass(m.Role) }>
					<div class="message-role">
						if m.Role == model.RoleStudent {
							{ t(ctx, "You") }
						} else {
							{ t(ctx, "Evaluator") }
						}
					</div>
					if m.Role == model.RoleStudent {
						<div>{ m.Text() }</div>
					} else {
						<div class="markdown">@evaluatorMessage(m)
</div>
					}
					if liveScore.Show && m.Score != nil {
						<div class="message-score">
							<strong>{ t(ctx, "LLMScore") }</strong> { fmt.Sprintf("%.1f", *m.Score) } / { strconv.Itoa(question.MaxPoints) }
							if liveScore.Preliminary {
								<em>({ t(ctx, "Preliminary") })</em>
							}
						</div>
					}
				</div>
			}
		</div>
	}
	if session.Status == model.StatusInProgress && thread.Status != model.ThreadCompleted {
		if thread.Status == model.ThreadEvaluating {
			@feedbackPending(session.ID, thread.ID)
		} else {
			{{ retry := len(messages) > 0 && messages[len(messages)-1].Role == model.RoleStudent }}
			{{ action := p(ctx, fmt.Sprintf("/exam/%d/answer/%d", session.ID, thread.ID)) }}
			<form
				method="POST"
				action={ templ.SafeURL(action) }
				hx-post={ action }
				hx-target="closest .thread-feedback"
				hx-swap="innerHTML"
				hx-disabled-elt="find .answer-input, find button"
			>
				<input type="hidden" name="csrf_token" value={ csrf(ctx) }/>
				<input type="hidden" name="answer_key" value={ answerKey(messages) }/>
				<p class="form-error" role="alert" hidden></p>
				if retry {
					<p role="status">{ t(ctx, "FeedbackFailed") }</p>
					<input type="hidden" name="retry" value="1"/>
					<button type="submit">{ t(ctx, "RetryEvaluation") }</button>
				} else {
					<textarea
						class="answer-input"
						name="answer"
						rows="4"
						required
						disabled?={ timeExceeded }
						if len(messages) > 0 {
							placeholder={ t(ctx, "TypeFollowup") }
						} else {
							placeholder={ t(ctx, "TypeAnswer") }
						}
					></textarea>
					<button class="answer-submit" type="submit" disabled?={ timeExceeded }>
						if len(messages) > 0 {
							{ t(ctx, "Reply") }
						} else {
							{ t(ctx, "Answer") }
						}
					</button>
				}
			</form>
		}
	}
}

templ feedbackPending(sessionID, threadID int64) {
	<p
		role="status"
		hx-get={ p(ctx, fmt.Sprintf("/exam/%d/answer/%d", sessionID, threadID)) }
		hx-trigger="every 2s"
		hx-target="closest .thread-feedback"
		hx-swap="innerHTML"
	>
		{ t(ctx, "FeedbackPending") }
	</p>
}

// The form describes the exact conversation turn shown to the student.
func answerKey(messages []model.Message) string {
	if len(messages) == 0 {
		return "0"
	}
	return strconv.FormatInt(messages[len(messages)-1].ID, 10)
}

func threadStatusLabel(ctx context.Context, status model.ThreadStatus) string {
	switch status {
	case model.ThreadOpen:
		return t(ctx, "ThreadOpen")
	case model.ThreadAnswered:
		return t(ctx, "ThreadAnswered")
	case model.ThreadCompleted:
		return t(ctx, "ThreadCompleted")
	case model.ThreadEvaluating:
		return t(ctx, "Evaluating")
	case model.ThreadFeedbackFailed:
		return t(ctx, "FeedbackUnavailable")
	default:
		return string(status)
	}
}

func messageClass(role model.Role) string {
	if role == model.RoleStudent {
		return "message-student"
	}
	return "message-assistant"
}
