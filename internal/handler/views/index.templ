package views

import (
	"context"
	"fmt"
	"strconv"

	"github.com/pavelanni/examiner/internal/model"
)

// isStudentOnly identifies students for links that differ from teacher review.
func isStudentOnly(ctx context.Context) bool {
	u := model.UserFromContext(ctx)
	return u != nil && u.Role == model.UserRoleStudent
}

// TopicChoice is one exam topic on the home page, as the user sees it.
type TopicChoice struct {
	Topic     string
	Available bool   // a new exam can start in this topic
	Note      string // why a complete exam cannot be drawn
}

// IndexData is what the home page shows.
type IndexData struct {
	Sessions       []model.ExamSession
	AvailableCount int // questions exams can draw from
	ExamCount      int // questions in one exam
	Config         model.ExamConfig
	Topics         []TopicChoice
	Error          string // why the last start failed
}

// openTopics filters the topics that can supply a complete new exam.
func openTopics(topics []TopicChoice) []TopicChoice {
	var out []TopicChoice
	for _, c := range topics {
		if c.Available {
			out = append(out, c)
		}
	}
	return out
}

// distributionParams supplies the localized summary of an exam's exact counts.
func distributionParams(d model.Distribution) map[string]any {
	return map[string]any{
		"Easy":   d[model.DifficultyEasy],
		"Medium": d[model.DifficultyMedium],
		"Hard":   d[model.DifficultyHard],
		"Total":  d.Total(),
	}
}

// topicLabel gives an explicitly empty topic a visible, localized name.
func topicLabel(ctx context.Context, topic string) string {
	if topic == "" {
		return t(ctx, "ExamUntitledTopic")
	}
	return topic
}

templ IndexPage(d IndexData) {
	@Layout(t(ctx, "AppTitle")) {
		<h1>{ t(ctx, "AppTitle") }</h1>
		<p>{ t(ctx, "AppSubtitle") }</p>
		if d.Error != "" {
			<article role="alert" style="border-left: 4px solid var(--pico-del-color);">
				<p>{ d.Error }</p>
			</article>
		}
		<section>
			<h2>{ t(ctx, "StartNewExam") }</h2>
			if d.AvailableCount > 0 || d.Config.Selection != nil {
				@examSize(d)
				if len(openTopics(d.Topics)) == 0 {
					<p>{ t(ctx, "ExamNoTopicsAvailable") }</p>
					<ul>
						for _, c := range d.Topics {
							if c.Note != "" {
								<li>{ topicLabel(ctx, c.Topic) }: { c.Note }</li>
							}
						}
					</ul>
				} else {
					<form method="POST" action={ templ.SafeURL(p(ctx, "/exam/start")) }>
						<input type="hidden" name="csrf_token" value={ csrf(ctx) }/>
						if len(d.Topics) > 1 {
							<label for="topic">{ t(ctx, "SelectTopic") }</label>
							<select id="topic" name="topic">
								for _, c := range d.Topics {
									if c.Available {
										<option value={ c.Topic }>{ topicLabel(ctx, c.Topic) }</option>
									} else {
										<option value={ c.Topic } disabled>{ topicLabel(ctx, c.Topic) } — { c.Note }</option>
									}
								}
							</select>
						} else {
							<input type="hidden" name="topic" value={ d.Topics[0].Topic }/>
							<p><small>{ t(ctx, "FilterTopic") }: <strong>{ topicLabel(ctx, d.Topics[0].Topic) }</strong></small></p>
						}
						<button type="submit">
							if len(d.Topics) <= 1 || d.Config.Selection != nil {
								{ t(ctx, "StartExam") }
								({ td(ctx, "NQuestions", map[string]any{"N": strconv.Itoa(d.ExamCount)}) })
							} else {
								{ t(ctx, "StartExam") }
							}
						</button>
					</form>
				}
			} else {
				<p>{ t(ctx, "NoQuestionsLoaded") }</p>
			}
		</section>
		if len(d.Sessions) > 0 {
			<section>
				<h2>{ t(ctx, "PreviousSessions") }</h2>
				<table>
					<thead>
						<tr>
							<th>{ t(ctx, "ColID") }</th>
							<th>{ t(ctx, "ColStatus") }</th>
							<th>{ t(ctx, "ColStarted") }</th>
							<th>{ t(ctx, "ColAction") }</th>
						</tr>
					</thead>
					<tbody>
						for _, s := range d.Sessions {
							<tr>
								<td>{ fmt.Sprint(s.ID) }</td>
								<td>{ string(s.Status) }</td>
								<td>{ s.StartedAt.Format("2006-01-02 15:04") }</td>
								<td>
									if s.Status == model.StatusInProgress {
										<a href={ templ.SafeURL(p(ctx, fmt.Sprintf("/exam/%d", s.ID))) }>{ t(ctx, "Continue") }</a>
									} else if isStudentOnly(ctx) {
										<a href={ templ.SafeURL(p(ctx, fmt.Sprintf("/results/%d", s.ID))) }>{ t(ctx, "ViewResults") }</a>
									} else {
										<a href={ templ.SafeURL(p(ctx, fmt.Sprintf("/review/%d", s.ID))) }>{ t(ctx, "Review") }</a>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</section>
		}
		if !isStudentOnly(ctx) {
			<section>
				<h2>{ t(ctx, "TeacherReview") }</h2>
				<a href={ templ.SafeURL(p(ctx, "/review")) } role="button" class="secondary">{ t(ctx, "GoToReviewDashboard") }</a>
			</section>
		}
	}
}

// examSize describes how many questions an exam has.
templ examSize(d IndexData) {
	if d.Config.Selection != nil {
		<p>
			<small>
				{ td(ctx, "ExamDistribution", distributionParams(d.Config.Selection)) }
				if d.Config.Shuffle {
					{ " " }({ t(ctx, "Shuffled") })
				}
			</small>
		</p>
	} else if len(d.Topics) <= 1 {
		<p>{ tp(ctx, "QuestionsAvailable", d.AvailableCount) }</p>
		if d.Config.Difficulty != "" || d.Config.Topic != "" {
			<p>
				<small>
					if d.Config.Difficulty != "" {
						{ t(ctx, "FilterDifficulty") }: <strong>{ d.Config.Difficulty }</strong>
						if d.Config.Topic != "" {
							{ " · " }
						}
					}
					if d.Config.Topic != "" {
						{ t(ctx, "FilterTopic") }: <strong>{ d.Config.Topic }</strong>
					}
				</small>
			</p>
		}
		if d.ExamCount != d.AvailableCount {
			<p>
				<small>
					{ td(ctx, "ExamWillUse", map[string]any{"Count": strconv.Itoa(d.ExamCount)}) }
					if d.Config.Shuffle {
						{ " " }({ t(ctx, "Shuffled") })
					}
				</small>
			</p>
		} else if d.Config.Shuffle {
			<p><small>{ t(ctx, "Shuffled") }</small></p>
		}
	}
}
