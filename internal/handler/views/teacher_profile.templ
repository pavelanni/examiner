package views

import (
	"fmt"
	"net/url"
)

// QuestionSet is one of the teacher's question files: File is the stored
// file name, Name what the teacher called it.
type QuestionSet struct {
	File string
	Name string
}

// SaveSummary is the result of the last save, shown once on the profile.
type SaveSummary struct {
	Name     string
	Inserted int
	Updated  int
	Skipped  int
}

templ TeacherProfilePage(sets []QuestionSet, saved *SaveSummary) {
	@Layout(t(ctx, "QSetListTitle")) {
		<h1>{ t(ctx, "QSetListTitle") }</h1>
		<p>{ t(ctx, "QSetListIntro") }</p>
		if saved != nil {
			<article role="status" style="border-left: 4px solid var(--pico-ins-color);">
				{ td(ctx, "QSetSaved", map[string]any{"Name": saved.Name, "Inserted": saved.Inserted, "Updated": saved.Updated, "Skipped": saved.Skipped}) }
			</article>
		}
		<p>
			<a href={ templ.SafeURL(p(ctx, "/teacher/create-test")) } role="button">{ t(ctx, "QSetCreate") }</a>
		</p>
		if len(sets) == 0 {
			<p>{ t(ctx, "QSetEmpty") }</p>
		} else {
			<table>
				<tbody>
					for _, s := range sets {
						<tr>
							<td>{ s.Name }</td>
							<td style="text-align: right;">
								<a href={ templ.SafeURL(p(ctx, fmt.Sprintf("/teacher/create-test?file=%s", url.QueryEscape(s.File)))) } role="button" class="secondary">{ t(ctx, "QSetEdit") }</a>
								<a href={ templ.SafeURL(p(ctx, "/teacher/tests/file/"+url.PathEscape(s.File))) } role="button" class="outline">{ t(ctx, "QSetDownload") }</a>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}
	}
}
